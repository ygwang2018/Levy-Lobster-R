test_fig10 <- function() {
  
  # Load or use existing Gamma GLM from your INT model:
  # glm_int must be Gamma with log link
  glm_int_f <- glm(INT ~ PL + NINT, data=lobster[lobster$SEX=="Female",], family=Gamma(link="log"))
  glm_int_m <- glm(INT ~ PL + NINT, data=lobster[lobster$SEX=="Male",], family=Gamma(link="log"))
  
  # Parameters from Table 6
  k_f <- 0.283;  zeta_f <- 75.055;  Linf_f <- 183.87
  k_m <- 0.2473; zeta_m <- 59.947; Linf_m <- 228.04
  
  n <- 100
  
  # Simulate
  sim_f <- simulate_growth_A(n, k_f, zeta_f, "fixed", Linf_f, glm_int_f)
  sim_f$id <- rep(1:n, table(sim_f$t==0)[1])
  
  sim_m <- simulate_growth_A(n, k_m, zeta_m, "fixed", Linf_m, glm_int_m)
  sim_m$id <- rep(1:n, table(sim_m$t==0)[1])
  
  # Random-effects versions require ln_params(mean, sd)
  ln_f <- ln_params(183.27, 12)
  ln_m <- ln_params(184.34, 12)
  
  sim_fr <- simulate_growth_A(n, k_f, zeta_f, "lognormal", ln_f, glm_int_f)
  sim_fr$id <- rep(1:n, table(sim_fr$t==0)[1])
  
  sim_mr <- simulate_growth_A(n, k_m, zeta_m, "lognormal", ln_m, glm_int_m)
  sim_mr$id <- rep(1:n, table(sim_mr$t==0)[1])
  
  # Output
  if (!dir.exists("results/figures")) dir.create("results/figures", recursive=TRUE)
  png("results/figures/fig9_simulation.png", width=1500, height=1200, res=150)
  
  par(mfrow=c(2,2), mar=c(4,4,3,1))
  plot_panel_A(sim_f,  k_f, Linf_f, expression("Females – Fixed " * L[infinity]))
  plot_panel_A(sim_m,  k_m, Linf_m, expression("Males – Fixed "   * L[infinity]))
  plot_panel_A(sim_fr, k_f, 183.27, expression("Females – Random-effects " * L[infinity]))
  plot_panel_A(sim_mr, k_m, 184.34, expression("Males – Random-effects "   * L[infinity]))
  
  dev.off()
  }
