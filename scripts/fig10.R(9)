plot_panel <- function(df, k, Linf_mean, title_expr) {

  # 1. Base plot (empty canvas)
  plot(NA, NA,
       xlim = c(0, 10),
       ylim = range(df$L, na.rm = TRUE),
       xlab = "Years",
       ylab = "Length (mm)",
       main = title_expr)

  # 2. Stepwise lines (simulated growth)
  ids <- unique(df$i)

  for (id in ids) {
    d <- df[df$i == id, ]

    # Step function: repeat each time & length
    tt <- rep(d$Ti/365, each = 2)
    LL <- rep(d$L,    each = 2)
    tt <- tt[-1]     # drop 1st
    LL <- LL[-length(LL)]  # drop last

    lines(tt, LL, col = rgb(0,0,0,0.20), lwd = 1)
  }

  # 3. Mean empirical stepwise curve
  t_grid <- seq(0, 10, length.out = 500)

  mean_curve <- sapply(t_grid, function(t) {

    vals <- sapply(ids, function(id) {
      d <- df[df$i == id, ]
      idx <- max(which(d$Ti/365 <= t))
      if (length(idx) == 0) return(NA_real_)
      d$L[idx]
    })

    m <- mean(vals, na.rm = TRUE)
    if (!is.finite(m)) m <- NA_real_
    m
  })

  # Guarantee equal lengths (avoids xy.coords error)
  stopifnot(length(mean_curve) == length(t_grid))

  # Smooth dashed line for empirical mean curve
  lines(t_grid, mean_curve, col = "black", lwd = 2, lty = 2)

  # 4. Theoretical VB curve (cyan)
  L_vb <- Linf_mean * (1 - exp(-k * t_grid))
  lines(t_grid, L_vb, col = "cyan3", lwd = 2)
}
